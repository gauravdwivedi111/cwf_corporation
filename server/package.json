{
  "name": "cwf-corporation-server",
  "version": "1.0.0",
  "description": "Backend server API for CWF Corporation",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "node scripts/seed_all.js",
    "verify": "node scripts/verify_models.js",
    "test:cloudinary": "node scripts/test_cloudinary.js",
    "backup": "node scripts/backup_db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "sanitize-html": "^2.17.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "eslint": "^9.1.1",
    "globals": "^15.0.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2"
  },
  "jest": {
    "moduleNameMapper": {
      "^sanitize-html$": "<rootDir>/tests/mocks/sanitizeHtmlMock.js",
      "^nodemailer$": "<rootDir>/tests/mocks/nodemailerMock.js"
    }
  }
}
