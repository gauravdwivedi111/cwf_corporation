# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
MONGO_URI=mongodb://localhost:27017/cwf_corporation

# Authentication / Security (Phase 2 Auth Design)
JWT_SECRET=your_jwt_access_token_secret_here
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_here
JWT_REFRESH_EXPIRE=7d

# Image Uploads (Cloudinary API Credentials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Lead / Inquiry Notifications (Email Service config)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_or_app_password
EMAIL_FROM=notifications@cwfcorporation.com
EMAIL_TO_NOTIFY=admin@cwfcorporation.com
